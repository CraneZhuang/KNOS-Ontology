<rdf:RDF
    xml:base="http://example.org/ontology/fibo-loans-step-4/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/fibo-loans-step-4/">

  <owl:Ontology rdf:about="">
    <rdfs:label>FIBO 贷款实验 — 第四步：风险分类器</rdfs:label>
    <rdfs:comment>用于授信审核和抵押品层次建模的风险分类实体，改编自 EDM Council FIBO。来源：https://github.com/edmcouncil/fibo；MIT 许可。</rdfs:comment>
  </owl:Ontology>

  <!-- All entities from Steps 1-3 -->
  <owl:Class rdf:about="Loan">
    <rdfs:label>Loan</rdfs:label>
    <rdfs:comment>向借款人提供、按合同条款偿还的债务工具。</rdfs:comment>
    <ont:icon>📄</ont:icon>
    <ont:color>#00A9E0</ont:color>
  </owl:Class>

  <owl:Class rdf:about="Borrower">
    <rdfs:label>Borrower</rdfs:label>
    <rdfs:comment>接收资金并承担偿还义务的一方。</rdfs:comment>
    <ont:icon>👤</ont:icon>
    <ont:color>#0078D4</ont:color>
  </owl:Class>

  <owl:Class rdf:about="Lender">
    <rdfs:label>Lender</rdfs:label>
    <rdfs:comment>按贷款合同提供资金或信用的一方。</rdfs:comment>
    <ont:icon>🏦</ont:icon>
    <ont:color>#107C10</ont:color>
  </owl:Class>

  <owl:Class rdf:about="Collateral">
    <rdfs:label>Collateral</rdfs:label>
    <rdfs:comment>为担保偿还义务而质押的资产。</rdfs:comment>
    <ont:icon>🏠</ont:icon>
    <ont:color>#D83B01</ont:color>
  </owl:Class>

  <owl:Class rdf:about="LoanPaymentSchedule">
    <rdfs:label>LoanPaymentSchedule</rdfs:label>
    <rdfs:comment>定义到期日期与预期还款额的定期计划。</rdfs:comment>
    <ont:icon>🗓️</ont:icon>
    <ont:color>#5C2D91</ont:color>
  </owl:Class>

  <owl:Class rdf:about="Servicer">
    <rdfs:label>Servicer</rdfs:label>
    <rdfs:comment>负责收取贷款还款的金融服务机构。</rdfs:comment>
    <ont:icon>🧾</ont:icon>
    <ont:color>#008272</ont:color>
  </owl:Class>

  <owl:Class rdf:about="PaymentHistory">
    <rdfs:label>PaymentHistory</rdfs:label>
    <rdfs:comment>贷款账户全部支付事件的记录。</rdfs:comment>
    <ont:icon>📚</ont:icon>
    <ont:color>#FFB900</ont:color>
  </owl:Class>

  <owl:Class rdf:about="PaymentTransaction">
    <rdfs:label>PaymentTransaction</rdfs:label>
    <rdfs:comment>构成支付历史的单次支付事件。</rdfs:comment>
    <ont:icon>💸</ont:icon>
    <ont:color>#E81123</ont:color>
  </owl:Class>

  <!-- New in Step 4 -->
  <owl:Class rdf:about="OwnershipInterest">
    <rdfs:label>OwnershipInterest</rdfs:label>
    <rdfs:comment>描述抵押资产所有权性质的分类器，改编自 fibo-fnd-oac-own:OwnershipInterest。</rdfs:comment>
    <ont:icon>📜</ont:icon>
    <ont:color>#486991</ont:color>
  </owl:Class>

  <owl:Class rdf:about="LenderLienPosition">
    <rdfs:label>LenderLienPosition</rdfs:label>
    <rdfs:comment>描述贷款人对抵押资产债权顺位的分类器，改编自 fibo-fbc-dae-dbt:LenderLienPosition。</rdfs:comment>
    <ont:icon>🏅</ont:icon>
    <ont:color>#8764B8</ont:color>
  </owl:Class>

  <!-- Properties -->
  <owl:DatatypeProperty rdf:about="loanId">
    <rdfs:label>loanId</rdfs:label>
    <rdfs:domain rdf:resource="Loan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="principalAmount">
    <rdfs:label>principalAmount</rdfs:label>
    <rdfs:domain rdf:resource="Loan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <ont:propertyType>decimal</ont:propertyType>
    <ont:unit>USD</ont:unit>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="borrowerId">
    <rdfs:label>borrowerId</rdfs:label>
    <rdfs:domain rdf:resource="Borrower"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="lenderId">
    <rdfs:label>lenderId</rdfs:label>
    <rdfs:domain rdf:resource="Lender"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="assetType">
    <rdfs:label>assetType</rdfs:label>
    <rdfs:domain rdf:resource="Collateral"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="scheduleId">
    <rdfs:label>scheduleId</rdfs:label>
    <rdfs:domain rdf:resource="LoanPaymentSchedule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="servicerId">
    <rdfs:label>servicerId</rdfs:label>
    <rdfs:domain rdf:resource="Servicer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="paymentHistoryId">
    <rdfs:label>paymentHistoryId</rdfs:label>
    <rdfs:domain rdf:resource="PaymentHistory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="paymentTransactionId">
    <rdfs:label>paymentTransactionId</rdfs:label>
    <rdfs:domain rdf:resource="PaymentTransaction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="amount">
    <rdfs:label>amount</rdfs:label>
    <rdfs:domain rdf:resource="PaymentTransaction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <ont:propertyType>decimal</ont:propertyType>
    <ont:unit>USD</ont:unit>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="ownershipInterestType">
    <rdfs:label>ownershipInterestType</rdfs:label>
    <rdfs:domain rdf:resource="OwnershipInterest"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="lienPosition">
    <rdfs:label>lienPosition</rdfs:label>
    <rdfs:domain rdf:resource="LenderLienPosition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <ont:propertyType>string</ont:propertyType>
    <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="positionRank">
    <rdfs:label>positionRank</rdfs:label>
    <rdfs:domain rdf:resource="LenderLienPosition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <ont:propertyType>integer</ont:propertyType>
  </owl:DatatypeProperty>

  <!-- Relationships -->
  <owl:ObjectProperty rdf:about="owedBy">
    <rdfs:label>owedBy</rdfs:label>
    <rdfs:domain rdf:resource="Loan"/>
    <rdfs:range rdf:resource="Borrower"/>
    <rdfs:comment>连接贷款与承担偿还义务的借款人。</rdfs:comment>
    <ont:cardinality>many-to-one</ont:cardinality>
    <ont:fromEntityId>Loan</ont:fromEntityId>
    <ont:toEntityId>Borrower</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="originatedBy">
    <rdfs:label>originatedBy</rdfs:label>
    <rdfs:domain rdf:resource="Loan"/>
    <rdfs:range rdf:resource="Lender"/>
    <rdfs:comment>连接贷款与发放贷款的机构。</rdfs:comment>
    <ont:cardinality>many-to-one</ont:cardinality>
    <ont:fromEntityId>Loan</ont:fromEntityId>
    <ont:toEntityId>Lender</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="securedBy">
    <rdfs:label>securedBy</rdfs:label>
    <rdfs:domain rdf:resource="Loan"/>
    <rdfs:range rdf:resource="Collateral"/>
    <rdfs:comment>连接担保贷款与质押资产。</rdfs:comment>
    <ont:cardinality>one-to-many</ont:cardinality>
    <ont:fromEntityId>Loan</ont:fromEntityId>
    <ont:toEntityId>Collateral</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="repaidBySchedule">
    <rdfs:label>repaidBySchedule</rdfs:label>
    <rdfs:domain rdf:resource="Loan"/>
    <rdfs:range rdf:resource="LoanPaymentSchedule"/>
    <rdfs:comment>连接贷款与还款计划。</rdfs:comment>
    <ont:cardinality>one-to-one</ont:cardinality>
    <ont:fromEntityId>Loan</ont:fromEntityId>
    <ont:toEntityId>LoanPaymentSchedule</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="servicedBy">
    <rdfs:label>servicedBy</rdfs:label>
    <rdfs:domain rdf:resource="Loan"/>
    <rdfs:range rdf:resource="Servicer"/>
    <rdfs:comment>连接贷款与负责收款的服务机构。</rdfs:comment>
    <ont:cardinality>many-to-one</ont:cardinality>
    <ont:fromEntityId>Loan</ont:fromEntityId>
    <ont:toEntityId>Servicer</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasPaymentHistory">
    <rdfs:label>hasPaymentHistory</rdfs:label>
    <rdfs:domain rdf:resource="LoanPaymentSchedule"/>
    <rdfs:range rdf:resource="PaymentHistory"/>
    <rdfs:comment>连接还款计划与支付历史记录。</rdfs:comment>
    <ont:cardinality>one-to-one</ont:cardinality>
    <ont:fromEntityId>LoanPaymentSchedule</ont:fromEntityId>
    <ont:toEntityId>PaymentHistory</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasIndividualPayment">
    <rdfs:label>hasIndividualPayment</rdfs:label>
    <rdfs:domain rdf:resource="PaymentHistory"/>
    <rdfs:range rdf:resource="PaymentTransaction"/>
    <rdfs:comment>连接支付历史记录与各笔支付交易。</rdfs:comment>
    <ont:cardinality>one-to-many</ont:cardinality>
    <ont:fromEntityId>PaymentHistory</ont:fromEntityId>
    <ont:toEntityId>PaymentTransaction</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="classifiesCollateralOwnership">
    <rdfs:label>classifiesCollateralOwnership</rdfs:label>
    <rdfs:domain rdf:resource="OwnershipInterest"/>
    <rdfs:range rdf:resource="Collateral"/>
    <rdfs:comment>按所有权权益类别对抵押品分类。</rdfs:comment>
    <ont:cardinality>one-to-many</ont:cardinality>
    <ont:fromEntityId>OwnershipInterest</ont:fromEntityId>
    <ont:toEntityId>Collateral</ont:toEntityId>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasLienPosition">
    <rdfs:label>hasLienPosition</rdfs:label>
    <rdfs:domain rdf:resource="Collateral"/>
    <rdfs:range rdf:resource="LenderLienPosition"/>
    <rdfs:comment>按贷款人债权顺位对抵押品分类。</rdfs:comment>
    <ont:cardinality>many-to-one</ont:cardinality>
    <ont:fromEntityId>Collateral</ont:fromEntityId>
    <ont:toEntityId>LenderLienPosition</ont:toEntityId>
  </owl:ObjectProperty>

</rdf:RDF>
