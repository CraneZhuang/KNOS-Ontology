<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/university-step-2/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/university-step-2/">

    <!-- Ontology Declaration -->
    <owl:Ontology rdf:about="">
        <rdfs:label>大学 — 第二步：教师</rdfs:label>
        <rdfs:comment>添加 Professor 及授课、指导关系。</rdfs:comment>
    </owl:Ontology>

    <!-- ======================== -->
    <!-- Classes                  -->
    <!-- ======================== -->

    <owl:Class rdf:about="#Student">
        <rdfs:label>Student</rdfs:label>
        <rdfs:comment>在大学就读的学生。</rdfs:comment>
        <ont:icon>🎓</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="#Course">
        <rdfs:label>Course</rdfs:label>
        <rdfs:comment>大学开设的课程。</rdfs:comment>
        <ont:icon>📚</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="#Enrollment">
        <rdfs:label>Enrollment</rdfs:label>
        <rdfs:comment>学生在特定课程中的选课记录。</rdfs:comment>
        <ont:icon>📝</ont:icon>
        <ont:color>#00B7C3</ont:color>
    </owl:Class>

    <owl:Class rdf:about="#Professor">
        <rdfs:label>Professor</rdfs:label>
        <rdfs:comment>教授课程并指导学生的教师。</rdfs:comment>
        <ont:icon>👨‍🏫</ont:icon>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <!-- ======================== -->
    <!-- Data Properties          -->
    <!-- ======================== -->

    <!-- Student properties -->
    <owl:DatatypeProperty rdf:about="#studentId">
        <rdfs:label>studentId</rdfs:label>
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
        <ont:isIdentifier>true</ont:isIdentifier>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#student_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#major">
        <rdfs:label>major</rdfs:label>
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#gpa">
        <rdfs:label>gpa</rdfs:label>
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#enrollmentYear">
        <rdfs:label>enrollmentYear</rdfs:label>
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Course properties -->
    <owl:DatatypeProperty rdf:about="#courseCode">
        <rdfs:label>courseCode</rdfs:label>
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
        <ont:isIdentifier>true</ont:isIdentifier>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#title">
        <rdfs:label>title</rdfs:label>
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#credits">
        <rdfs:label>credits</rdfs:label>
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#level">
        <rdfs:label>level</rdfs:label>
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#maxEnrollment">
        <rdfs:label>maxEnrollment</rdfs:label>
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Enrollment properties -->
    <owl:DatatypeProperty rdf:about="#enrollmentId">
        <rdfs:label>enrollmentId</rdfs:label>
        <rdfs:domain rdf:resource="#Enrollment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
        <ont:isIdentifier>true</ont:isIdentifier>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#semester">
        <rdfs:label>semester</rdfs:label>
        <rdfs:domain rdf:resource="#Enrollment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#grade">
        <rdfs:label>grade</rdfs:label>
        <rdfs:domain rdf:resource="#Enrollment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#status">
        <rdfs:label>status</rdfs:label>
        <rdfs:domain rdf:resource="#Enrollment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- Professor properties -->
    <owl:DatatypeProperty rdf:about="#facultyId">
        <rdfs:label>facultyId</rdfs:label>
        <rdfs:domain rdf:resource="#Professor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
        <ont:isIdentifier>true</ont:isIdentifier>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#prof_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="#Professor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#department">
        <rdfs:label>department</rdfs:label>
        <rdfs:domain rdf:resource="#Professor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tenure">
        <rdfs:label>tenure</rdfs:label>
        <rdfs:domain rdf:resource="#Professor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <ont:propertyType>boolean</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#researchArea">
        <rdfs:label>researchArea</rdfs:label>
        <rdfs:domain rdf:resource="#Professor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ======================== -->
    <!-- Object Properties        -->
    <!-- ======================== -->

    <owl:ObjectProperty rdf:about="#student_enrolls">
        <rdfs:label>enrolled_in</rdfs:label>
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="#Enrollment"/>
        <rdfs:comment>学生登记记录</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>Student</ont:fromEntityId>
        <ont:toEntityId>Enrollment</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#enrollment_for">
        <rdfs:label>for_course</rdfs:label>
        <rdfs:domain rdf:resource="#Enrollment"/>
        <rdfs:range rdf:resource="#Course"/>
        <rdfs:comment>课程选修记录</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>Enrollment</ont:fromEntityId>
        <ont:toEntityId>Course</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#prof_teaches">
        <rdfs:label>teaches</rdfs:label>
        <rdfs:domain rdf:resource="#Professor"/>
        <rdfs:range rdf:resource="#Course"/>
        <rdfs:comment>讲授的课程</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>Professor</ont:fromEntityId>
        <ont:toEntityId>Course</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#student_advised">
        <rdfs:label>advised_by</rdfs:label>
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="#Professor"/>
        <rdfs:comment>学业导师</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>Student</ont:fromEntityId>
        <ont:toEntityId>Professor</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
