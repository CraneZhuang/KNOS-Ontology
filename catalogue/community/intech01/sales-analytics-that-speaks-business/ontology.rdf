    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/customerBalance_balanceAmount">
        <rdfs:label>balanceAmount</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/CustomerBalance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/salesPerformance_performanceId">
        <rdfs:label>performanceId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/SalesPerformance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/revenue_revenueId">
        <rdfs:label>revenueId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Revenue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/revenue_revenueValue">
        <rdfs:label>revenueValue</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Revenue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
