        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ================== -->
    <!-- Object Properties -->
    <!-- ================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/places">
        <rdfs:label>places</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Order"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>customer</ont:fromEntityId>
        <ont:toEntityId>order</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/hasAddress">
        <rdfs:label>has address</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/CustomerAddress"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>customer</ont:fromEntityId>
        <ont:toEntityId>customerAddress</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/maintains">
        <rdfs:label>maintains balance</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/CustomerBalance"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>customer</ont:fromEntityId>
        <ont:toEntityId>customerBalance</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/receives">
        <rdfs:label>receives</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Invoice"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>customer</ont:fromEntityId>
        <ont:toEntityId>invoice</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/files">
        <rdfs:label>files return</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Return"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>customer</ont:fromEntityId>
        <ont:toEntityId>return</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/contains">
        <rdfs:label>contains</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Item"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>item</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/fulfilledBy">
        <rdfs:label>fulfilled by</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Warehouse"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>warehouse</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/handledBy">
        <rdfs:label>handled by</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/SalesPerson"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>order</ont:fromEntityId>
        <ont:toEntityId>salesPerson</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/generatesInvoice">
        <rdfs:label>generates invoice</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Order"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-analytics-that-speaks-businessusing-fabric-iq-ontology/Invoice"/>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>order</ont:fromEntityId>
