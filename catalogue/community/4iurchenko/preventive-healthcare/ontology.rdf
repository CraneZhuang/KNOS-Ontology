        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/new-entity-5_purchase_id">
        <rdfs:label>purchase_id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-5"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/new-entity-6_id">
        <rdfs:label>id</rdfs:label>
