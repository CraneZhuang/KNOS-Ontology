<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/">

    <owl:Ontology rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/">
        <rdfs:label>预防保健与健康评估</rdfs:label>
        <rdfs:comment>面向美国劳动年龄成年人的 D2C 健康评估本体。v0.6 以 Purchase 为渠道、支付和产品归因的锚点，含 15 个实体、17 条关系。实体编号及 ont:x、ont:y 对应原始设计图的从上到下、从左到右布局。</rdfs:comment>
    </owl:Ontology>

    <!-- ===================== -->
    <!-- Entity Types (Classes) -->
    <!-- ===================== -->

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-1">
        <rdfs:label>ActionCompletion</rdfs:label>
        <rdfs:comment>会员完成推荐行动的记录，来源可为自行报告、系统检测或已验证。</rdfs:comment>
        <ont:icon>📈</ont:icon>
        <ont:color>#008272</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-2">
        <rdfs:label>EngagementMessage</rdfs:label>
        <rdfs:comment>根据健康报告向会员发送的提示、提醒或指导消息。</rdfs:comment>
        <ont:icon>📝</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-3">
        <rdfs:label>EmployerChannelPartner</rdfs:label>
        <rdfs:comment>促成购买的雇主或合作渠道，例如赞助活动或联合品牌交易。</rdfs:comment>
        <ont:icon>🏢</ont:icon>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-4">
        <rdfs:label>Action</rdfs:label>
        <rdfs:comment>健康报告生成的建议，如生活方式调整、复查预约、基层医生转诊或习惯培养，可针对某个风险标记。</rdfs:comment>
        <ont:icon>🎯</ont:icon>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-5">
        <rdfs:label>WellbeingReport</rdfs:label>
        <rdfs:comment>购买后交付给会员的健康报告，记录综合评分及相对上一份报告的变化。</rdfs:comment>
        <ont:icon>📋</ont:icon>
        <ont:color>#00A9E0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-6">
        <rdfs:label>Purchase</rdfs:label>
        <rdfs:comment>一次 Purchase 对应一次健康评估交付，可为独立套餐或会员权益交付；v0.6 中还关联付款方式、渠道归因和产品。</rdfs:comment>
        <ont:icon>🛒</ont:icon>
        <ont:color>#D83B01</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-7">
        <rdfs:label>Member</rdfs:label>
        <rdfs:comment>健康评估服务的最终消费者，是健康数据采集、评分与长期跟踪的主体。</rdfs:comment>
        <ont:icon>👤</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-8">
        <rdfs:label>PaymentMethod</rdfs:label>
        <rdfs:comment>每条记录表示已保存的一张银行卡或一个银行账户，通过 paidWith 关联 Purchase。</rdfs:comment>
        <ont:icon>🔗</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-9">
        <rdfs:label>RiskFlag</rdfs:label>
        <rdfs:comment>从观测结果推断的临床风险提示，例如糖尿病前期、高血压或抑郁风险；具有从发现到解除的生命周期。</rdfs:comment>
        <ont:icon>⚡</ont:icon>
        <ont:color>#E81123</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-10">
        <rdfs:label>BillingEvent</rdfs:label>
        <rdfs:comment>一次扣款、退款或拒付尝试。kind 为 refund 或 chargeback 时，reversesBillingEventId 指向原扣款记录。</rdfs:comment>
        <ont:icon>💳</ont:icon>
        <ont:color>#E81123</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-11">
        <rdfs:label>Membership</rdfs:label>
        <rdfs:comment>会员对周期性产品的订阅记录，每次续订新增一行；仅当前有效行的 isCurrent 为 true。会员记录行数用于计算续订次数。</rdfs:comment>
        <ont:icon>🏷️</ont:icon>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-12">
        <rdfs:label>Product</rdfs:label>
        <rdfs:comment>产品目录 SKU，会员购买的会员资格、套餐或附加项，定义价格和周期。</rdfs:comment>
        <ont:icon>📦</ont:icon>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-13">
        <rdfs:label>Observation</rdfs:label>
        <rdfs:comment>一次接触产生的数据点，如生物标志物、生理测量或问卷回答，使用 LOINC 或 SNOMED 编码。</rdfs:comment>
        <ont:icon>📊</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-14">
        <rdfs:label>Encounter</rdfs:label>
        <rdfs:comment>产生数据的单次接触，例如信息采集、生理测量或采血。</rdfs:comment>
        <ont:icon>🎯</ont:icon>
        <ont:color>#00A9E0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/New-entity-15">
        <rdfs:label>LabPartner</rdfs:label>
        <rdfs:comment>执行采血和生物标志物分析的外部实验室。</rdfs:comment>
        <ont:icon>🔧</ont:icon>
        <ont:color>#008272</ont:color>
    </owl:Class>

