        <ont:fromEntityId>new-entity-6</ont:fromEntityId>
        <ont:toEntityId>new-entity-14</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/preventiveHealthcare-wellbeing-check-ontology-v06/relation-4">
