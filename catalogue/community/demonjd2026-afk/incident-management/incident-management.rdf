    <owl:DatatypeProperty rdf:about="http://example.org/ontology/incident-management/new-entity-1_status">
        <rdfs:label>status</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/incident-management/New-entity-1"/>
