        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>LearningCompletion 的键属性。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/learning-ontology/learningCompletion_completionStatus">
        <rdfs:label>completionStatus</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/learning-ontology/LearningCompletion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>LearningCompletion 的必填非键属性。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/learning-ontology/learningCompletion_completionDate">
        <rdfs:label>completionDate</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/learning-ontology/LearningCompletion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>LearningCompletion 的必填非键属性。</rdfs:comment>
        <ont:propertyType>date</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/learning-ontology/learningCompletion_score">
        <rdfs:label>score</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/learning-ontology/LearningCompletion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>LearningCompletion 的必填非键属性。</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/learning-ontology/learningCompletion_attemptNumber">
        <rdfs:label>attemptNumber</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/learning-ontology/LearningCompletion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>LearningCompletion 的可选非键属性，表示重试次数。</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/learning-ontology/skill_skillId">
        <rdfs:label>skillId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/learning-ontology/Skill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Skill 的键属性。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/learning-ontology/skill_skillName">
        <rdfs:label>skillName</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/learning-ontology/Skill"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Skill 的必填非键属性。</rdfs:comment>
