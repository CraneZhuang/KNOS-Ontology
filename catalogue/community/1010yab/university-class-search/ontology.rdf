<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/nauclasssearchontology/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/nauclasssearchontology/">

    <owl:Ontology rdf:about="http://example.org/ontology/nauclasssearchontology/">
        <rdfs:label>大学课程检索本体</rdfs:label>
        <rdfs:comment>用于 NAU 课程检索数据智能体的本体。保留内部 RDF 标识符以维持图连接；实体显示名称使用下划线，关系标签使用自然语言。模型区分 Course 与 Course_Offering；开课项目由学科和课程编号组成，并承载先修及其他修读条件。Term 与 Session 分开建模，每学期可含多个按周计的教学时段。建筑连接校区，校区连接学院；教学班选课受 Academic_Policy 和 Reserve_Capacity_Rule 控制。</rdfs:comment>
    </owl:Ontology>

    <!-- ===================== -->
    <!-- Entity Types (Classes) -->
    <!-- ===================== -->

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/Course">
        <rdfs:label>Course</rdfs:label>
        <rdfs:comment>课程目录层面的稳定教学概念，包含标题、学分、学业类别、级别和详细课程说明。可开设的具体变体、学科与编号组合、course_offer_number 及修读条件由 Course_Offering 表达。</rdfs:comment>
        <ont:icon>🎓</ont:icon>
        <ont:color>#2F80ED</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/CourseOffering">
        <rdfs:label>Course_Offering</rdfs:label>
        <rdfs:comment>基于 PeopleSoft course_id + course_offer_number 的开课项目，由 Subject 与 catalog_number 组成，隶属于 Course，可安排为 Class_Section，并承载先修、同修、分级、等效及建议准备规则。</rdfs:comment>
        <ont:icon>🧾</ont:icon>
        <ont:color>#6C63FF</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/Subject">
        <rdfs:label>Subject</rdfs:label>
        <rdfs:comment>CS、BIO、MATH、PSY、EE 等学科代码。学科映射到教学组织及学院，以支持学科归属推理。</rdfs:comment>
        <ont:icon>🔤</ont:icon>
        <ont:color>#1ABC9C</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/College">
        <rdfs:label>College</rdfs:label>
        <rdfs:comment>学院级教学分组，可包含多个教学组织，并拥有或关联多个学科。</rdfs:comment>
        <ont:icon>🏫</ont:icon>
        <ont:color>#F2A541</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/ClassSection">
        <rdfs:label>Class_Section</rdfs:label>
        <rdfs:comment>学生可选的教学班：某个 Course_Offering 在特定 Session 中的排课实例。记录选课人数、容量、状态、授课模式、班号、多项上课安排、教师、预留名额及加课、退课、候补政策。</rdfs:comment>
        <ont:icon>🗓️</ont:icon>
        <ont:color>#00A6ED</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/Term">
        <rdfs:label>Term</rdfs:label>
        <rdfs:comment>秋季、春季或夏季学期，长度按周计算，可包含多个 Session。例如 12 周夏季学期中可安排多个 5 周教学时段。</rdfs:comment>
        <ont:icon>📅</ont:icon>
        <ont:color>#00B894</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/Session">
        <rdfs:label>Session</rdfs:label>
        <rdfs:comment>学期内的教学时段，例如 12 周暑期班或第一、二、三个 5 周暑期班。每个时段按周计，可包含多个教学班。</rdfs:comment>
        <ont:icon>⏱️</ont:icon>
        <ont:color>#20C997</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/EnrollmentDateRule">
        <rdfs:label>Academic_Policy</rdfs:label>
        <rdfs:comment>管理教学班选课时间与规则的教务政策，包括开放选课、加退课窗口、候补规则、退学截止日期及特定时段或班级限制。</rdfs:comment>
        <ont:icon>🚦</ont:icon>
        <ont:color>#FF8C42</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/ProfessorInstructor">
        <rdfs:label>Instructor</rdfs:label>
        <rdfs:comment>负责教学班的教授或教师。以 EMPLID 或其他人员标识符作为稳定自然键，instructor_name 作为显示名称。</rdfs:comment>
        <ont:icon>👩‍🏫</ont:icon>
        <ont:color>#9B51E0</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/AcademicOrganization">
        <rdfs:label>Academic_Organization</rdfs:label>
        <rdfs:comment>学院、学部、系、学校等教学归属组织，支持按组织、学科归属、课程归属和专业归属查询。</rdfs:comment>
        <ont:icon>🏛️</ont:icon>
        <ont:color>#F2994A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/MeetingPattern">
        <rdfs:label>Meeting_Pattern</rdfs:label>
        <rdfs:comment>教学班的上课日期、时间和地点安排；同一班级可有讲授、实验、实习等多项安排。</rdfs:comment>
        <ont:icon>🕒</ont:icon>
        <ont:color>#27AE60</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/FacilityRoom">
        <rdfs:label>Room</rdfs:label>
        <rdfs:comment>上课安排所使用的实体教室或设施，位于某栋建筑中。</rdfs:comment>
        <ont:icon>🚪</ont:icon>
        <ont:color>#56CCF2</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/Building">
        <rdfs:label>Building</rdfs:label>
        <rdfs:comment>包含一个或多个教室、位于某校区的校园建筑。</rdfs:comment>
        <ont:icon>🏢</ont:icon>
        <ont:color>#828282</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/Campus">
        <rdfs:label>Campus</rdfs:label>
        <rdfs:comment>建筑和教学班所属的校区或地点，如 Flagstaff Mountain Campus。本模型中校区隶属于学院。</rdfs:comment>
        <ont:icon>🌲</ont:icon>
        <ont:color>#145A32</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/ReserveCapacityRule">
        <rdfs:label>Reserve_Capacity_Rule</rdfs:label>
        <rdfs:comment>允许符合条件的学生群体选课的预留名额规则。一个教学班可有多条规则，记录预留座位、适用人群、审批要求和选课人数。</rdfs:comment>
        <ont:icon>🔐</ont:icon>
        <ont:color>#EB5757</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/ClassAttribute">
        <rdfs:label>Class_Attribute</rdfs:label>
        <rdfs:comment>附于教学班或开课项目的属性，如通识教育、CCAT、教学组成、讲授、实验、实习等分类。</rdfs:comment>
        <ont:icon>🏷️</ont:icon>
        <ont:color>#F2C94C</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/RequisiteRule">
        <rdfs:label>Requisite_Rule</rdfs:label>
        <rdfs:comment>先修、同修、等效、分级或建议准备规则。规则关联目标开课项目，并指向先修开课项目，避免直接形成 Course 到 Course 的循环。</rdfs:comment>
        <ont:icon>🔗</ont:icon>
        <ont:color>#BB6BD9</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/AcademicProgram">
        <rdfs:label>Academic_Program</rdfs:label>
        <rdfs:comment>包含教学要求的学位、培养方案、证书或专业，可能要求修读 Course 或 Course_Offering。</rdfs:comment>
        <ont:icon>🎯</ont:icon>
        <ont:color>#219653</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/nauclasssearchontology/AcademicRequirement">
        <rdfs:label>Academic_Requirement</rdfs:label>
        <rdfs:comment>培养方案中的要求，如毕业综合实践、实验科学、通识教育、专业必修或先修路径，可由课程或开课项目满足。</rdfs:comment>
        <ont:icon>✅</ont:icon>
        <ont:color>#2D9CDB</ont:color>
    </owl:Class>

    <!-- ================ -->
    <!-- Data Properties -->
    <!-- ================ -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_course_id">
        <rdfs:label>course_id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>PeopleSoft COURSE_ID 或长期稳定的课程标识符。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_course_title">
        <rdfs:label>course_title</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>课程名称。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_course_description">
        <rdfs:label>course_description</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>用于 AI 文本检索的课程目录详细说明。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_academic_career">
        <rdfs:label>academic_career</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>学业类别，例如 UGRD 或 GRAD。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_academic_level">
        <rdfs:label>academic_level</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>教学层次，例如本科或研究生。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_units">
        <rdfs:label>units</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Course"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>学分或课程单位数。</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/courseOffering_course_offering_key">
        <rdfs:label>course_offering_key</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>开课项目业务标识符，通常由 course_id + course_offer_number 组成。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/courseOffering_course_id">
        <rdfs:label>course_id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>从父级课程继承的 PeopleSoft COURSE_ID。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/courseOffering_course_offer_number">
        <rdfs:label>course_offer_number</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>PeopleSoft COURSE_OFFER_NUMBER，属于 Course_Offering，而不是通用 Course 概念。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/courseOffering_subject_code">
        <rdfs:label>subject_code</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>开课代码第一部分的学科代码，例如 CS、BIO、MATH、PSY、EE。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/courseOffering_catalog_number">
        <rdfs:label>catalog_number</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>开课代码第二部分的目录编号，例如 101、238、310。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/courseOffering_course_code">
        <rdfs:label>course_code</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>学科与目录编号组合的显示代码，例如 CS 310、MATH 238。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/courseOffering_offering_status">
        <rdfs:label>offering_status</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>开课项目是否启用、停用或可安排教学班。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/subject_subject_code">
        <rdfs:label>subject_code</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Subject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>学科代码，例如 CS、BIO、MATH、PSY、EE。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/subject_subject_description">
        <rdfs:label>subject_description</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Subject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>完整学科说明。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/college_college_code">
        <rdfs:label>college_code</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/College"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>学院代码或标识符。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/college_college_name">
        <rdfs:label>college_name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/College"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>学院名称。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/classSection_class_section_sk">
        <rdfs:label>class_section_sk</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>教学班代理键。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/classSection_class_section_business_key">
        <rdfs:label>class_section_business_key</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>教学班复合业务键，通常为 course_id + course_offer_number + term_id + session_id + class_section_id。</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/classSection_term_id">
        <rdfs:label>term_id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>教学班学期代码。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/classSection_session_id">
        <rdfs:label>session_id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>教学班时段代码。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/classSection_class_section_id">
        <rdfs:label>class_section_id</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>PeopleSoft CLASS_SECTION 或教学班标识符。</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/classSection_class_number">
        <rdfs:label>class_number</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>面向学生显示的班号。</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/nauclasssearchontology/classSection_delivery_mode">
        <rdfs:label>delivery_mode</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
