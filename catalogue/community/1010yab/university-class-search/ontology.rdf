    <!-- ================== -->
    <!-- Object Properties -->
    <!-- ================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_has_course_offering">
        <rdfs:label>has</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Course"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:comment>目录级 Course 可有一个或多个 Course_Offering，将稳定课程概念与 PeopleSoft course_offer_number 及具体开课项目的修读规则分离。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>course</ont:fromEntityId>
        <ont:toEntityId>courseOffering</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_offering_for_course">
        <rdfs:label>of</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/Course"/>
        <rdfs:comment>每个 Course_Offering 隶属于一个父级 Course。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>courseOffering</ont:fromEntityId>
        <ont:toEntityId>course</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_offering_has_subject">
        <rdfs:label>has</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/Subject"/>
        <rdfs:comment>Course_Offering 由 Subject 与 catalog_number 组成。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>courseOffering</ont:fromEntityId>
        <ont:toEntityId>subject</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/subject_mapped_to_academic_organization">
        <rdfs:label>owned by</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Subject"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/AcademicOrganization"/>
        <rdfs:comment>Subject 映射到拥有或管理该学科的 Academic_Organization。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>subject</ont:fromEntityId>
        <ont:toEntityId>academicOrganization</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/college_has_academic_organization">
        <rdfs:label>owns</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/College"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/AcademicOrganization"/>
        <rdfs:comment>College 可包含学部、学校或系等多个 Academic_Organization。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>college</ont:fromEntityId>
        <ont:toEntityId>academicOrganization</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_offering_has_section">
        <rdfs:label>schedules</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:comment>Course_Offering 可跨学期和时段安排多个 Class_Section。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>courseOffering</ont:fromEntityId>
        <ont:toEntityId>classSection</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/class_section_for_course_offering">
        <rdfs:label>of</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:comment>Class_Section 是某个 Course_Offering 的排课实例，通过课程、开课编号、学期、时段和班级标识符关联。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>classSection</ont:fromEntityId>
        <ont:toEntityId>courseOffering</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/term_has_session">
        <rdfs:label>has</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Term"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/Session"/>
        <rdfs:comment>Term 可包含多个按周计的 Session，例如 12 周夏季学期中的第一、二、三个 5 周教学时段。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>term</ont:fromEntityId>
        <ont:toEntityId>session</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/session_part_of_term">
        <rdfs:label>in</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Session"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/Term"/>
        <rdfs:comment>Session 隶属于一个 Term。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>session</ont:fromEntityId>
        <ont:toEntityId>term</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/class_section_offered_in_session">
        <rdfs:label>in</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/Session"/>
        <rdfs:comment>Class_Section 开设于一个 Session，该时段隶属于某个 Term。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>classSection</ont:fromEntityId>
        <ont:toEntityId>session</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/session_has_class_section">
        <rdfs:label>has</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Session"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:comment>Session 可包含多个 Class_Section。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>session</ont:fromEntityId>
        <ont:toEntityId>classSection</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/class_section_has_enrollment_date_rule">
        <rdfs:label>governed by</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/EnrollmentDateRule"/>
        <rdfs:comment>Class_Section 受 Academic_Policy 控制，包括选课开放、加退课、候补和退出截止日期。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>classSection</ont:fromEntityId>
        <ont:toEntityId>enrollmentDateRule</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/class_section_taught_by">
        <rdfs:label>taught by</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/ProfessorInstructor"/>
        <rdfs:comment>Class_Section 由 Professor_Instructor 授课。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>classSection</ont:fromEntityId>
        <ont:toEntityId>professorInstructor</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/professor_instructor_teaches_class_section">
        <rdfs:label>teaches</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ProfessorInstructor"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:comment>Professor_Instructor 教授一个或多个 Class_Section。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>professorInstructor</ont:fromEntityId>
        <ont:toEntityId>classSection</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/professor_instructor_affiliated_with">
        <rdfs:label>affiliated with</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ProfessorInstructor"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/AcademicOrganization"/>
        <rdfs:comment>Professor_Instructor 可隶属于 Academic_Organization。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>professorInstructor</ont:fromEntityId>
        <ont:toEntityId>academicOrganization</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/class_section_has_meeting_pattern">
        <rdfs:label>has</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/MeetingPattern"/>
        <rdfs:comment>Class_Section 可有讲授、实验、实习、讨论等多项 Meeting_Pattern。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>classSection</ont:fromEntityId>
        <ont:toEntityId>meetingPattern</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/meeting_pattern_occurs_in_facility_room">
        <rdfs:label>occur in</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/MeetingPattern"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/FacilityRoom"/>
        <rdfs:comment>Meeting_Pattern 在指定 Facility_Room 中进行。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>meetingPattern</ont:fromEntityId>
        <ont:toEntityId>facilityRoom</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/facility_room_located_in_building">
        <rdfs:label>in </rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/FacilityRoom"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/Building"/>
        <rdfs:comment>Facility_Room 位于 Building 中。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>facilityRoom</ont:fromEntityId>
        <ont:toEntityId>building</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/building_located_on_campus">
        <rdfs:label>on </rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Building"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/Campus"/>
        <rdfs:comment>Building 位于 Campus 中。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>building</ont:fromEntityId>
        <ont:toEntityId>campus</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/campus_belongs_to_academic_organization">
        <rdfs:label>belongs to </rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/Campus"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/College"/>
        <rdfs:comment>Campus 隶属于 College。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>campus</ont:fromEntityId>
        <ont:toEntityId>college</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/class_section_has_reserve_capacity_rule">
        <rdfs:label>has</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/ReserveCapacityRule"/>
        <rdfs:comment>Class_Section 可有多条 Reserve_Capacity_Rule，允许符合条件的学生群体选课。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>classSection</ont:fromEntityId>
        <ont:toEntityId>reserveCapacityRule</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/reserve_capacity_rule_allows_enrollment_in_class_section">
        <rdfs:label>applies to</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ReserveCapacityRule"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:comment>Reserve_Capacity_Rule 允许符合资格的学生使用预留名额加入 Class_Section。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>reserveCapacityRule</ont:fromEntityId>
        <ont:toEntityId>classSection</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/class_section_has_attribute">
        <rdfs:label>has</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassSection"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/ClassAttribute"/>
        <rdfs:comment>Class_Section 可包含通识教育、CCAT、组成、授课模式、讲授、实验、实习等属性。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>classSection</ont:fromEntityId>
        <ont:toEntityId>classAttribute</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/course_offering_has_requisite_rule">
        <rdfs:label>has</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/RequisiteRule"/>
        <rdfs:comment>Course_Offering 可有先修、同修、分级、等效或建议准备规则，学生选其教学班前需评估这些规则。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>courseOffering</ont:fromEntityId>
        <ont:toEntityId>requisiteRule</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/requisite_rule_applies_to_course_offering">
        <rdfs:label>applies to</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/RequisiteRule"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/CourseOffering"/>
        <rdfs:comment>学生希望修读的目标 Course_Offering；其教学班受 Requisite_Rule 阻止或附加条件限制。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>requisiteRule</ont:fromEntityId>
        <ont:toEntityId>courseOffering</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/academic_program_has_requirement">
        <rdfs:label>has</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/AcademicProgram"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/AcademicRequirement"/>
        <rdfs:comment>Academic_Program 包含一个或多个 Academic_Requirement。</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>academicProgram</ont:fromEntityId>
        <ont:toEntityId>academicRequirement</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/academic_requirement_satisfied_by_course">
        <rdfs:label>satisfied by </rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/AcademicRequirement"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/Course"/>
        <rdfs:comment>Academic_Requirement 可由一个或多个 Course 满足。</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>academicRequirement</ont:fromEntityId>
        <ont:toEntityId>course</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/nauclasssearchontology/academic_program_owned_by_academic_organization">
        <rdfs:label>owned by </rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/nauclasssearchontology/AcademicProgram"/>
        <rdfs:range rdf:resource="http://example.org/ontology/nauclasssearchontology/AcademicOrganization"/>
        <rdfs:comment>Academic_Program 由 Academic_Organization 管理。</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>academicProgram</ont:fromEntityId>
        <ont:toEntityId>academicOrganization</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
